# Environment Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
# If left empty, API defaults to embedded PostgreSQL (PGlite) with local file storage in ./data/brightloop-pg
DATABASE_URL=postgresql://brightloop:brightloop_secret@localhost:5432/brightloop
PGLITE_DATA_DIR=./data/brightloop-pg

# Security & Session
JWT_SECRET=brightloop-hackathon-jwt-secret-key-32chars-min
COOKIE_SECRET=brightloop-hackathon-cookie-secret-key-32chars-min
CORS_ORIGIN=http://localhost:5173

# Billing Engine
INVOICE_AUTO_CONFIRM=true
BUSINESS_TIMEZONE=Asia/Kolkata

# SMTP / Mailpit (optional local email sink)
SMTP_HOST=localhost
SMTP_PORT=1025
FROM_EMAIL=no-reply@brightloop.com
